-- O SEU ESP de Drawing API modificado para Esqueleto e Caixa
local function updateDrawingESP()
    if not drawingSupported then return end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            local char = plr.Character
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            
            if head and hrp and hum and hum.Health > 0 and espEnabled then
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    if not ESPS[plr] then
                        -- Cria os desenhos pro jogador
                        ESPS[plr] = {
                            box = newDrawing("Square"),
                            name = newDrawing("Text"),
                            tracer = newDrawing("Line"),
                            skel = {}
                        }
                        for i=1, 6 do ESPS[plr].skel[i] = newDrawing("Line") end
                        
                        -- Configurações visuais
                        if ESPS[plr].box then
                            ESPS[plr].box.Thickness = 1
                            ESPS[plr].box.Color = espColor
                            ESPS[plr].box.Filled = false
                        end
                        if ESPS[plr].name then
                            ESPS[plr].name.Size = 14
                            ESPS[plr].name.Center = true
                            ESPS[plr].name.Outline = true
                            ESPS[plr].name.Color = COLOR_TEXT
                        end
                        if ESPS[plr].tracer then
                            ESPS[plr].tracer.Thickness = 1
                            ESPS[plr].tracer.Color = espColor
                        end
                        for i=1, 6 do
                            if ESPS[plr].skel[i] then
                                ESPS[plr].skel[i].Thickness = 1
                                ESPS[plr].skel[i].Color = Color3.fromRGB(255, 165, 0) -- Laranja
                            end
                        end
                    end
                    
                    -- Atualiza posições (Lógica baseada na distância)
                    local tbl = ESPS[plr]
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    local h = math.clamp(2500 / dist, 40, 300)
                    local w = h / 2
                    
                    if tbl.box then
                        tbl.box.Visible = true
                        tbl.box.Size = Vector2.new(w, h)
                        tbl.box.Position = Vector2.new(screenPos.X - w/2, screenPos.Y - h/2)
                    end
                    
                    if tbl.name then
                        tbl.name.Visible = true
                        tbl.name.Text = plr.Name .. " [" .. math.floor(dist) .. "m]"
                        tbl.name.Position = Vector2.new(screenPos.X, screenPos.Y - h/2 - 15)
                    end
                    
                    if tbl.tracer then
                        tbl.tracer.Visible = true
                        tbl.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tbl.tracer.To = Vector2.new(screenPos.X, screenPos.Y + h/2)
                    end
                    
                    -- Lógica do Esqueleto
                    local parts = {
                        head = head,
                        ut = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
                        lt = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso"),
                        la = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm"),
                        ra = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm"),
                        ll = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg"),
                        rl = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
                    }
                    
                    local function getP(p)
                        if p then local sp, os = Camera:WorldToViewportPoint(p.Position); if os then return Vector2.new(sp.X, sp.Y) end end
                        return nil
                    end
                    
                    local hP, utP, ltP, laP, raP, llP, rlP = getP(parts.head), getP(parts.ut), getP(parts.lt), getP(parts.la), getP(parts.ra), getP(parts.ll), getP(parts.rl)
                    
                    if hP and utP then tbl.skel[1].From = hP; tbl.skel[1].To = utP; tbl.skel[1].Visible = true else tbl.skel[1].Visible = false end
                    if utP and ltP then tbl.skel[2].From = utP; tbl.skel[2].To = ltP; tbl.skel[2].Visible = true else tbl.skel[2].Visible = false end
                    if utP and laP then tbl.skel[3].From = utP; tbl.skel[3].To = laP; tbl.skel[3].Visible = true else tbl.skel[3].Visible = false end
                    if utP and raP then tbl.skel[4].From = utP; tbl.skel[4].To = raP; tbl.skel[4].Visible = true else tbl.skel[4].Visible = false end
                    if ltP and llP then tbl.skel[5].From = ltP; tbl.skel[5].To = llP; tbl.skel[5].Visible = true else tbl.skel[5].Visible = false end
                    if ltP and rlP then tbl.skel[6].From = ltP; tbl.skel[6].To = rlP; tbl.skel[6].Visible = true else tbl.skel[6].Visible = false end

                else
                    -- Jogador na tela? Esconde tudo
                    if ESPS[plr] then
                        if ESPS[plr].box then ESPS[plr].box.Visible = false end
                        if ESPS[plr].name then ESPS[plr].name.Visible = false end
                        if ESPS[plr].tracer then ESPS[plr].tracer.Visible = false end
                        for i=1, 6 do if ESPS[plr].skel[i] then ESPS[plr].skel[i].Visible = false end end
                    end
                end
            elseif ESPS[plr] then
                -- Jogador morreu ou saiu
                if ESPS[plr].box then ESPS[plr].box.Visible = false end
                if ESPS[plr].name then ESPS[plr].name.Visible = false end
                if ESPS[plr].tracer then ESPS[plr].tracer.Visible = false end
                for i=1, 6 do if ESPS[plr].skel[i] then ESPS[plr].skel[i].Visible = false end end
            end
        end
    end
end

